# Change to your real production domain (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional: provided in Google Search Console.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional: ONLY fill after AdSense instructs you to connect this site.
# Example: ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_CLIENT=

# Enable only after reviewing privacy/consent requirements and Google approval.
NEXT_PUBLIC_ENABLE_ADSENSE=false
